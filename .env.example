# LLM opcional para redaccion de respuestas (proveedor compatible con OpenAI).
# Sin LLM_API_KEY el asistente opera en modo fragmentos (citas sin redaccion).
# En Vercel: Settings -> Environment Variables -> marcar entorno Production.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
LLM_API_KEY=
# Presupuesto total de reintentos (5xx) por consulta; margen bajo maxDuration=60s.
# LLM_TIMEOUT=45
# Cupo diario de llamadas a Groq (día UTC). Vacío = 300. 0 = ilimitado.
LLM_DAILY_BUDGET=
# Rate limit distribuido (opcional). Si faltan o Redis falla, se usa memoria.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Embeddings en producción. cloudflare = Workers AI (default en Vercel),
# local = fastembed (ingesta/dev), api = Jina, off = solo BM25.
# EMBEDDINGS_PROVIDER=cloudflare
# Credenciales de Cloudflare Workers AI. Nunca commitear el token.
CF_ACCOUNT_ID=
CF_API_TOKEN=
# Llamadas a Cloudflare por día UTC. Vacío = 300. 0 = ilimitado. El cache de consultas no consume cupo.
CF_DAILY_BUDGET=
# Timeout de la consulta de embeddings en segundos (default 2.0).
# EMBED_TIMEOUT_S=2.0
# Alternativa: Jina. Su key nunca se commitea.
JINA_API_KEY=
# Llamadas a Jina por día UTC. Vacío = 300. 0 = ilimitado. El cache de consultas no consume cupo.
JINA_DAILY_BUDGET=
